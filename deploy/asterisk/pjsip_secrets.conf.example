;==============================================================================
; Tez Motors — PJSIP SECRETS (copy to pjsip_secrets.conf and fill in).
;
;   cp pjsip_secrets.conf.example pjsip_secrets.conf   # then edit
;
; pjsip_secrets.conf is gitignored — it holds the trunk password, registration
; string, your DID, the provider IPs, and the softphone passwords. NEVER commit
; the filled-in copy. Generate softphone passwords with:  openssl rand -hex 24
;
; Fill ALL <…> placeholders from the Uztelecom welcome email / business SIP sheet.
;==============================================================================

;--- Uztelecom trunk: merge provider-specific values into the [uztelecom] endpoint
[uztelecom](+)
from_user=<YOUR_SIP_ACCOUNT_OR_DID>          ; e.g. 998XXXXXXXXX
from_domain=<PROVIDER_SIP_DOMAIN>            ; e.g. sip.uztelecom.uz

[uztelecom_aor](+)
contact=sip:<PROVIDER_SIP_HOST>:5060         ; the provider's SIP server host

;--- Auth WE present to the provider (registration-style trunks)
[uztelecom_auth]
type=auth
auth_type=userpass
username=<TRUNK_USERNAME>
password=<TRUNK_PASSWORD>

;--- Registration to the provider (KEEP if the trunk is registration-based; delete if pure IP-auth)
[uztelecom_reg]
type=registration
transport=transport-udp
outbound_auth=uztelecom_auth
server_uri=sip:<PROVIDER_SIP_HOST>:5060
client_uri=sip:<YOUR_SIP_ACCOUNT_OR_DID>@<PROVIDER_SIP_HOST>:5060
retry_interval=60
forbidden_retry_interval=300
expiration=3600

;--- Identify the provider by THEIR IP(s) so their inbound calls match [uztelecom]
;    (REQUIRED for IP-auth trunks; also good defense for registration trunks).
;    Get the exact signalling IP(s) from the welcome email — comma-separate or repeat `match`.
[uztelecom_identify]
type=identify
endpoint=uztelecom
match=<PROVIDER_SIP_IP_1>
;match=<PROVIDER_SIP_IP_2>

;--- Softphone rep 6001 (admin PWA). Long random password — see openssl above.
;    This same password also goes in the Vostro app .env.local as SOFTPHONE_PASSWORD.
[6001-auth]
type=auth
auth_type=userpass
username=6001
password=<RANDOM_SOFTPHONE_PASSWORD_6001>
