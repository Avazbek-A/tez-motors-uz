# Tez Motors — runtime env for the recording→CRM hook. Copy to /etc/asterisk/tez.env
# (apply.sh seeds it if missing). NOT committed (gitignored).
#
# Must MATCH the CALLS_UPLOAD_SECRET in the Vostro app's .env.local — that's what
# /api/admin/calls/upload-recording authenticates the Bearer token against.
CALLS_UPLOAD_SECRET=<paste-the-same-value-as-the-vostro-.env.local>

# Optional overrides:
# CALLS_UPLOAD_URL=https://tezmotors.uz/api/admin/calls/upload-recording
# TEZ_DELETE_AFTER_UPLOAD=1     # delete the local .wav after a confirmed 201 upload
